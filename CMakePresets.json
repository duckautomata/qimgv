{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Dev \u2014 debug, all features, fast iteration",
      "description": "What you want day to day. Debug symbols, no LTO, every optional feature on.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QIMGV_LTO": "OFF",
        "QIMGV_VIDEO_SUPPORT": "ON",
        "QIMGV_EXIV2": "ON",
        "QIMGV_OPENCV": "ON",
        "QIMGV_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "dev",
      "displayName": "Dev + AddressSanitizer / UBSan",
      "description": "Debug build with ASan+UBSan. Slow, but catches memory bugs.",
      "cacheVariables": {
        "QIMGV_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release \u2014 optimized, LTO",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QIMGV_LTO": "ON",
        "QIMGV_VIDEO_SUPPORT": "ON",
        "QIMGV_EXIV2": "ON",
        "QIMGV_OPENCV": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "release",
      "displayName": "Release + debug info \u2014 for profiling",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "QIMGV_LTO": "OFF"
      }
    },
    {
      "name": "minimal",
      "inherits": "base",
      "displayName": "Minimal \u2014 no video, no exiv2, no OpenCV",
      "description": "Smallest possible build. Useful for checking the optional-feature #ifdefs still compile.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QIMGV_VIDEO_SUPPORT": "OFF",
        "QIMGV_EXIV2": "OFF",
        "QIMGV_OPENCV": "OFF",
        "QIMGV_KDE_BLUR": "OFF"
      }
    },
    {
      "name": "ci",
      "inherits": "release",
      "displayName": "CI \u2014 release with warnings as errors",
      "cacheVariables": {
        "QIMGV_WERROR": "ON",
        "QIMGV_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msys2",
      "inherits": "release",
      "displayName": "Windows (MSYS2 UCRT64) \u2014 release package build",
      "description": "Run from a MSYS2 UCRT64 shell. See docs/BUILDING.md.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/dist"
      }
    },
    {
      "name": "macos",
      "inherits": "release",
      "displayName": "macOS \u2014 release .app bundle",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/dist",
        "QIMGV_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "minimal",
      "configurePreset": "minimal"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "windows-msys2",
      "configurePreset": "windows-msys2"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "ignore"
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
