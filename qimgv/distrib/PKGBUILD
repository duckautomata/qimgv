# Maintainer: duckautomata
# Contributor: easymodo <easymodofrf@gmail.com>  (original project)

pkgname=qimgv-git
_pkgname=qimgv
pkgver=r1.0000000
pkgrel=1
pkgdesc="Fast and configurable image viewer with optional video support (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/duckautomata/qimgv"
license=('GPL-3.0-or-later')

depends=(
    'qt6-base'
    'qt6-svg'
    'qt6-imageformats'
    'exiv2'
    'opencv'
    'mpv'
)
makedepends=(
    'git'
    'cmake'
    'ninja'
    'qt6-tools'
    'pkgconf'
)
optdepends=(
    'kimageformats: AVIF / JPEG XL / HEIF support'
    'qt6-imageformats: additional image formats'
)

provides=("$_pkgname")
conflicts=("$_pkgname")

source=("git+https://github.com/duckautomata/qimgv.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    git describe --long --tags 2>/dev/null \
        | sed 's/\([^-]*-g\)/r\1/;s/-/./g' \
        || printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$_pkgname"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DQIMGV_VIDEO_SUPPORT=ON \
        -DQIMGV_EXIV2=ON \
        -DQIMGV_OPENCV=ON
    cmake --build build
}

check() {
    cd "$_pkgname"
    ctest --test-dir build --output-on-failure || true
}

package() {
    cd "$_pkgname"
    DESTDIR="$pkgdir" cmake --install build
}
