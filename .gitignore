# ---- Editors / IDEs --------------------------------------------------------
# Note the trailing /* rather than /: git cannot re-include a file whose parent
# directory is itself excluded, so ".vscode/" would make the two ! lines dead.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.vs/
.cache/
.kdev4/
